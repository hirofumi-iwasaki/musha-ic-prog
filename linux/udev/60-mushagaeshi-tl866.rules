## SPDX-License-Identifier: GPL-3.0-or-later
## Derived from minipro/udev/60-minipro.rules at
## cae74c0607077d6260b24995f5e4c0d0b66a6a2e (GPL-3.0-or-later).
## TL866A/CS and the shared TL866II+/T48/T56 ID. uaccess grants the active
## local session access; plugdev is retained as a fallback for systems without
## logind. This does not make a detected model supported by the application.
ACTION!="add|change", GOTO="mushagaeshi_tl866_end"
SUBSYSTEM!="usb", GOTO="mushagaeshi_tl866_end"
ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="e11c", TAG+="uaccess", MODE="0660", GROUP="plugdev"
ATTRS{idVendor}=="a466", ATTRS{idProduct}=="0a53", TAG+="uaccess", MODE="0660", GROUP="plugdev"
LABEL="mushagaeshi_tl866_end"
