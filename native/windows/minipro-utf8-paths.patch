diff --git a/src/win_utf8_paths.c b/src/win_utf8_paths.c
new file mode 100644
--- /dev/null
+++ b/src/win_utf8_paths.c
@@ -0,0 +1,27 @@
+#include "win_utf8_paths.h"
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdlib.h>
+static wchar_t *minipro_utf8_to_wide(const char *name) {
+  if (!name) return NULL;
+  const int size = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, name, -1, NULL, 0);
+  if (!size) return NULL;
+  wchar_t *wide = malloc((size_t)size * sizeof(*wide));
+  if (!wide) return NULL;
+  if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, name, -1, wide, size)) { free(wide); return NULL; }
+  return wide;
+}
+FILE *minipro_fopen_utf8(const char *name, const char *mode) {
+  wchar_t *wide_name = minipro_utf8_to_wide(name);
+  wchar_t *wide_mode = minipro_utf8_to_wide(mode);
+  FILE *result = wide_name && wide_mode ? _wfopen(wide_name, wide_mode) : NULL;
+  free(wide_name); free(wide_mode); return result;
+}
+int minipro_stat_utf8(const char *name, struct stat *result) {
+  wchar_t *wide_name = minipro_utf8_to_wide(name);
+  if (!wide_name) return -1;
+  const int status = wstat(wide_name, result);
+  free(wide_name); return status;
+}
+#endif
