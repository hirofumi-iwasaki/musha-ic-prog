diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -3454,7 +3454,7 @@
 }
 
 /* Program Main entry point */
-int main(int argc, char **argv)
+int minipro_main(int argc, char **argv)
 {
 /* If we are in windows start the VT100 support.
 *  Set the Windows translation mode to binary.
@@ -3642,3 +3642,34 @@
 	minipro_close(handle);
 	return ret;
 }
+
+#ifdef _WIN32
+int wmain(int argc, wchar_t **wide_argv)
+{
+	char **argv = calloc((size_t)argc + 1, sizeof(*argv));
+	if (!argv)
+		return EXIT_FAILURE;
+	for (int index = 0; index < argc; ++index) {
+		const int size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,
+			wide_argv[index], -1, NULL, 0, NULL, NULL);
+		if (!size || !(argv[index] = malloc((size_t)size)) ||
+			!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[index],
+				-1, argv[index], size, NULL, NULL)) {
+			for (int cleanup = 0; cleanup <= index; ++cleanup)
+				free(argv[cleanup]);
+			free(argv);
+			return EXIT_FAILURE;
+		}
+	}
+	const int result = minipro_main(argc, argv);
+	for (int index = 0; index < argc; ++index)
+		free(argv[index]);
+	free(argv);
+	return result;
+}
+#else
+int main(int argc, char **argv)
+{
+	return minipro_main(argc, argv);
+}
+#endif
