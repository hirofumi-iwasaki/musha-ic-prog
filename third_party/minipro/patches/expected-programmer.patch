+static const char *canonical_model(const minipro_handle_t *handle)
+{
+	switch (handle->version) {
+	case MP_TL866A: return "tl866a";
+	case MP_TL866CS: return "tl866cs";
+	case MP_TL866IIPLUS: return "tl866ii";
+	case MP_T48: return "t48";
+	case MP_T56: return "t56";
+	case MP_T76: return "t76";
+	default: return "unknown";
+	}
+}
+
+static int usable_serial(const minipro_handle_t *handle)
+{
+	if (!handle->serial_number[0])
+		return 0;
+	for (const unsigned char *value = (const unsigned char *)handle->serial_number;
+	     *value; ++value) {
+		if (*value < 0x20 || *value > 0x7e || *value == '"' || *value == '\\')
+			return 0;
+	}
+	return 1;
 }
 
+static int expected_programmer_matches(const minipro_handle_t *handle,
+				       const cmdopts_t *cmdopts)
+{
+	if ((cmdopts->expected_model || cmdopts->expected_identity ||
+	     cmdopts->expected_firmware) &&
+	    (!cmdopts->expected_model || !cmdopts->expected_identity ||
+	     !cmdopts->expected_firmware)) {
+		fprintf(stderr, "Expected model, identity, and firmware must be supplied together.\n");
+		return 0;
+	}
+	if ((cmdopts->expected_model || cmdopts->expected_identity ||
+	     cmdopts->expected_firmware) && handle->status != MP_STATUS_NORMAL) {
+		fprintf(stderr, "Opened programmer is not in normal mode.\n");
+		return 0;
+	}
+	if (cmdopts->expected_model &&
+	    strcasecmp(cmdopts->expected_model, canonical_model(handle))) {
+		fprintf(stderr, "Expected programmer model %s, opened %s.\n",
+			cmdopts->expected_model, canonical_model(handle));
+		return 0;
+	}
+	if (cmdopts->expected_firmware &&
+	    strcmp(cmdopts->expected_firmware, handle->firmware_str)) {
+		fprintf(stderr, "Expected firmware %s, opened %s.\n",
+			cmdopts->expected_firmware, handle->firmware_str);
+		return 0;
+	}
+	if (cmdopts->expected_identity &&
+	    (!usable_serial(handle) ||
+	     strncmp(cmdopts->expected_identity, "serial:", 7) ||
+	     strcmp(cmdopts->expected_identity + 7, handle->serial_number))) {
+		fprintf(stderr, "Expected programmer identity does not match opened handle.\n");
+		return 0;
+	}
+	return 1;
+}
+
+void print_connection_json_and_exit(cmdopts_t *cmdopts)
+{
+	minipro_handle_t *handle = minipro_open(NO_VERBOSE);
+	if (!handle || handle->status != MP_STATUS_NORMAL || !usable_serial(handle)) {
+		fprintf(stderr, "[No uniquely identifiable programmer found]\n");
+		if (handle)
+			minipro_close(handle);
+		exit(EXIT_FAILURE);
+	}
+	printf("{\"schemaVersion\":1,\"model\":\"%s\",\"firmware\":\"%s\",\"serial\":\"%s\",\"identity\":\"serial:%s\"}\n",
+		canonical_model(handle), handle->firmware_str, handle->serial_number,
+		handle->serial_number);
+	minipro_close(handle);
+	exit(EXIT_SUCCESS);
+}
